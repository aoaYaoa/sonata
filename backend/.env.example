# 服务器配置
# 云平台（如 Render）通常会注入 PORT，应用会在 SERVER_PORT 未设置时自动使用 PORT。
SERVER_PORT=8080
SERVER_MODE=debug
CORS_ORIGIN=http://localhost:5173

# 应用口令（Solara 单口令登录）：至少 16 位，用 `openssl rand -base64 24` 生成。
# 留空会导致启动失败（旧版本留空会直接放行全部请求）。
APP_PASSWORD=

# 运行时数据目录（存放 yt_cookies.txt / bilibili_cookies.txt）
COOKIE_DIR=./data

# 媒体/图片代理白名单（逗号分隔；以 . 开头表示匹配子域）
IMG_PROXY_ALLOWED_HOSTS=.music.126.net,.126.net,.127.net,.netease.com
MEDIA_PROXY_ALLOWED_HOSTS=kuwo.cn,.bilivideo.com,.bilivideo.cn,.bilibili.com,.akamaized.net,.googlevideo.com

# 运维端点保护：设置后 /metrics 与 /swagger 需要 Bearer 令牌
METRICS_TOKEN=
# 生产环境请保持 false
ENABLE_SWAGGER=false

# 可信反向代理（留空表示不信任任何代理的 X-Forwarded-For）
TRUSTED_PROXIES=

# 是否允许不带 keys 参数导出全部 storage（默认关闭）
ALLOW_STORAGE_DUMP=false

# 数据库配置
# 支持的类型: mysql, postgres, mgdb
# postgres 用于 Supabase
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=appdb
DATABASE_USER=root
DATABASE_PASS=your_password_here
# PostgreSQL 可选: disable / require / verify-ca / verify-full
DATABASE_SSL_MODE=disable

# Supabase Session Pooler 配置示例
# 注意: DATABASE_HOST 只能填主机名，不要带 https://
# DATABASE_TYPE=postgres
# DATABASE_HOST=aws-1-<region>.pooler.supabase.com
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_USER=postgres.<project-ref>
# DATABASE_PASS=your_supabase_password
# DATABASE_SSL_MODE=require

# JWT配置
# JWT 密钥：至少 32 位，用 `openssl rand -base64 48` 生成。
# 含 your-/change-me/secret-key 等片段的弱密钥会被拒绝启动。
JWT_SECRET=

# 签名与加密配置（开启后必须提供 16/24/32 字节 AES 密钥）
ENABLE_SIGNATURE=false
SIGNATURE_SECRET=
ENCRYPTION_AES_KEY=

# Redis 配置（用于验证码缓存）
# Redis Cloud 示例（主机名/账号请替换为你自己的实例，切勿提交真实凭据）:
# REDIS_ADDR=redis-xxxxx.c000.region.cloud.redislabs.com:11366
# REDIS_USERNAME=default
# REDIS_PASSWORD=<从密钥管理服务注入>
# REDIS_DB=0
# REDIS_TLS=true
# REDIS_KEY_PREFIX=captcha:

# Kafka 配置（Aiven mTLS 示例）
# KAFKA_BROKERS=kafka-xxxx.aivencloud.com:18614
# KAFKA_TOPIC=test-topic
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_CA_FILE=./certs/kafka/ca.pem
# KAFKA_SSL_CERT_FILE=./certs/kafka/service.cert
# KAFKA_SSL_KEY_FILE=./certs/kafka/service.key

# Supabase 配置 (前端使用)
# SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
